# Copiar a .env y ajustar. .env no se sube al repositorio.
PORT=3000
DATABASE_URL=postgres://webfranco:CAMBIAR_CONTRASENA@localhost:5432/webfranco
# Solo en producción detrás de Nginx: número de proxies de confianza
# TRUST_PROXY=1
# NODE_ENV=production
# Dirección pública (enlaces de "¿Olvidaste tu contraseña?"). Ejemplo: https://equipo.red.ts.net
# URL_PUBLICA=
# Correo saliente para contraseñas iniciales y recuperación. Sin SMTP_HOST la contraseña se muestra en pantalla.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_USER=cuenta@gmail.com
# SMTP_PASS=contrasena_de_aplicacion
# SMTP_FROM=Plataforma de exámenes <cuenta@gmail.com>
